# Environment for lorawan-sniffer.service (/etc/lorawan-sniffer/sniffer.env).
#
# systemd reads this file as root before starting the sniffer, so it can stay
# readable by root only (mode 0600) while the sniffer itself runs unprivileged.
# Any variable set here can be used in sniffer.toml as "$NAME", which keeps
# secrets out of the world-readable configuration file.
#
# Single-quoted values are taken literally, so quotes, backslashes and "$" in
# a password need no escaping (a value cannot contain a single quote itself).
#
# MQTT_PASSWORD='change-me'
